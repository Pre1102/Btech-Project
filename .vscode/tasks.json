{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install and build VeriTrust AI",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"npm install && npm run build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run VeriTrust AI dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}